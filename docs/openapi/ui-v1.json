  "info": {
    "description": "Local-only control API. Loopback bind, per-session token, Host/Origin allowlists.",
    "title": "CogniRepo control API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/graph": {
      "get": {
        "description": "Read-only, bounded knowledge-graph slice (never the whole graph).",
        "operationId": "graph_api_v1_graph_get",
        "parameters": [
          {
            "in": "query",
            "name": "node",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 512,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Node"
            }
          },
          {
            "in": "query",
            "name": "depth",
            "required": false,
            "schema": {
              "default": 1,
              "maximum": 3,
              "minimum": 0,
              "title": "Depth",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 200,
              "maximum": 2000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "403": {
            "description": "Host or Origin header not allowed"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Locked out after repeated bad tokens (see Retry-After)"
          }
        },
        "summary": "Read-only, bounded knowledge-graph slice"
      }
    },
    "/api/v1/harness": {
      "get": {
        "description": "Which agent clients have CogniRepo's MCP server configured (names only, no args/env).",
        "operationId": "harness_api_v1_harness_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HarnessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "403": {
            "description": "Host or Origin header not allowed"
          },
          "429": {
            "description": "Locked out after repeated bad tokens (see Retry-After)"
          }
        },
        "summary": "Agent clients with CogniRepo configured"
      }
    },
    "/api/v1/insights": {
      "get": {
        "operationId": "insights_info_api_v1_insights_get",
